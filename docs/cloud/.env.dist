# Copy to /home/dad/workspace/www/cloud/.env  (chmod 600)
# Absolute path for Nextcloud user data. Must exist BEFORE the first start and cannot be changed
# afterwards without reinstalling. Not on a network drive.
NEXTCLOUD_DATADIR=/home/dad/workspace/www/cloud/ncdata
# docker0 gateway address (check: ip -4 addr show docker0). AIO's Apache is published only here.
APACHE_IP_BINDING=172.17.0.1
# Tailscale IP of the VPS: the AIO admin UI (8080) is published only on it.
TAILSCALE_IP=100.91.57.78
